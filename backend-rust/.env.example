# Salin ke .env dan isi nilai asli. Jangan commit .env.
HOST=0.0.0.0
PORT=8088

# Gunakan endpoint DIRECT Neon (tanpa -pooler) agar sqlx + migrasi stabil
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Mosquitto — pakai IP LAN yang sama dengan ESP (bukan 127.0.0.1 jika Windows Mosquitto service juga aktif)
MQTT_HOST=10.5.0.106
MQTT_PORT=1883
MQTT_CLIENT_ID=rfid-iot-backend
MQTT_TOPIC_PREFIX=iot/gistex
# Samakan dengan mosquitto_passwd (kosong = backend coba anonymous — hanya untuk transisi)
MQTT_USER=
MQTT_PASSWORD=

# Offline jika tidak ada telemetry selama N detik
OFFLINE_TIMEOUT_SEC=30
